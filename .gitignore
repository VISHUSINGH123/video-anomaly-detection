# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# PyTest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environments & Secrets
.env
.env.local

# Datasets, Features, Checkpoints, Outputs (Never commit large artifacts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors
checkpoints/**/*.pt
checkpoints/*.pt
!checkpoints/README.md
outputs/*
!outputs/README.md

# Hugging Face / Torch local caches
.cache/
hf_cache/
torch_cache/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
